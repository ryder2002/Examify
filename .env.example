ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=90
# SQLAlchemy uses psycopg 3 explicitly. PostgreSQL runs in the same Compose
# project; the migration URL may be left empty to reuse DATABASE_URL.
POSTGRES_DB=examify
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-postgres-admin-password
POSTGRES_APP_USER=examify_app
POSTGRES_APP_PASSWORD=replace-with-runtime-secret
POSTGRES_MAX_CONNECTIONS=80
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=6GB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
DATABASE_URL=postgresql+psycopg://examify_app:replace-with-runtime-secret@postgres:5432/examify
MIGRATION_DATABASE_URL=
# Optional monitoring profile; postgres-exporter expects a standard libpq DSN.
POSTGRES_EXPORTER_DSN=postgresql://postgres:replace-with-postgres-admin-password@postgres:5432/examify?sslmode=disable
# Conservative per-process SQLAlchemy pool defaults. With 4 API workers plus
# OCR, maintenance and beat these values retain PostgreSQL admin headroom.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=2000
DB_IDLE_TRANSACTION_TIMEOUT_MS=15000
AUTH_VERIFY_CONCURRENCY=4
PRESENCE_WRITE_INTERVAL_SECONDS=60
EXAM_MANIFEST_CACHE_TTL_SECONDS=600
EXAM_MANIFEST_CACHE_MAX_LOCAL=32
EXAM_MANIFEST_SINGLEFLIGHT_WAIT_SECONDS=8
MEDIA_AUTH_CACHE_TTL_SECONDS=300
IDENTITY_WEBSOCKET_INTERVAL_SECONDS=15
# Explicit cancel/logout cleans immediately. This bounds orphaned components
# left by a closed tab, browser crash or lost network.
PENDING_COMPONENT_RETENTION_HOURS=24
# API multipart scratch is an SSD-backed Docker volume, not RAM tmpfs.
# Defaults below support four concurrent maximum-size uploads (three Teachers
# plus one spare slot) while retaining at least 5 GiB recovery headroom.
API_LOCAL_CACHE_MAX_BYTES=2147483648
API_CACHE_EVICT_MIN_AGE_SECONDS=900
SCRATCH_MIN_FREE_BYTES=5368709120
SCRATCH_MIN_FREE_PERCENT=5
REDIS_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_USER=examifyminio
MINIO_ROOT_PASSWORD=replace-with-minio-root-password
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=examifyminio
MINIO_SECRET_KEY=replace-with-minio-root-password
MINIO_SECURE=false
# Backend MinIO guide media settings:
MINIO_BUCKET_SOURCES=examify-sources
MINIO_BUCKET_ASSETS=examify-assets
MINIO_BUCKET_AUDIO=examify-audio
MINIO_BUCKET_ANSWERS=examify-answers
MINIO_BUCKET_GUIDES=examify-guides
# Leave empty to serve a private bucket through the application media proxy.
MINIO_PUBLIC_URL=
# Production nginx serves this internal redirect after application authorization.
MINIO_ACCEL_REDIRECT_PREFIX=/_protected_minio
CLASS_ASSET_TOKEN_MINUTES=180
GUIDE_IMAGE_MAX_BYTES=10485760
GUIDE_VIDEO_MAX_BYTES=209715200
JWT_SECRET=replace-with-at-least-64-random-characters
# Keep this stable and backed up. Rotating it makes previously encrypted token
# codes impossible to export again.
TOKEN_EXPORT_SECRET=replace-with-a-separate-stable-secret-of-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
PUBLIC_BASE_URL=https://exam.congnhat.online
CORS_ALLOWED_ORIGINS=https://exam.congnhat.online,https://www.exam.congnhat.online,http://localhost,http://127.0.0.1
HTTP_PORT=80
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
GRAFANA_PORT=3001
# Continuous off-host MinIO mirror (enable with --profile backup):
BACKUP_S3_ENDPOINT=https://s3-compatible-backup.example.com
BACKUP_S3_ACCESS_KEY=replace
BACKUP_S3_SECRET_KEY=replace
# Monolith mode: OCR runs locally through Tesseract inside the bounded worker.
OCR_ENABLED=true
TESSERACT_LANG=eng
TESSERACT_DATA_DIR=
TESSERACT_TIMEOUT_SECONDS=90
OCR_ENGINE_POOL_SIZE=2
OMP_THREAD_LIMIT=2
OMP_NUM_THREADS=2
# Full-page Listening OCR defaults to the original 300-DPI render. Lowering it
# can make the small Part 3/4 question and option text incomplete.
OCR_LISTENING_PAGE_SCALE=1.0
OCR_READING_PAGE_SCALE=0.75
# Bounded parallel FFmpeg encoders for Audio Full auto-cut (1-3).
AUDIO_CUT_WORKERS=3
# Reading ROI is opt-in until its end-to-end latency is verified on the
# production CPU. The default path still has bounded recovery for incomplete
# question pages.
OCR_READING_ROI_ENABLED=0
OCR_READING_LOCATOR_DPI=150
OCR_READING_RECOVERY_PAGES=6
OCR_SCAN_RETRY_PAGES=12
MYMEMORY_CONTACT_EMAIL=admin@example.com
# Optional dictionary provider overrides:
# DICTIONARY_HTTP_TIMEOUT_SECONDS=8
# DICTIONARY_CACHE_TTL_SECONDS=604800
##SSHKEY NHATEM85
##ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMUNZh5T/MasE21b/cwBbbIojFwLW5vswH111jjF7kQD exam-tool-build
# Nếu bạn đã thêm remote tên secondary, quy trình là:
# git add .
# git commit -m "Mô tả thay đổi"
# git push secondary main
# Kiểm tra tên remote:
# git remote -v
# Nếu remote GitHub mới có tên khác, thay secondary bằng tên đó. Nếu muốn đẩy đồng thời lên cả repo cũ và repo mới:
# git push origin main
# git push secondary main
