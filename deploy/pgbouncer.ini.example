; Copy to the PgBouncer VM as /etc/pgbouncer/pgbouncer.ini.
; The PostgreSQL host publishes direct port 5433; port 5432 is PgBouncer.

[databases]
examify = host=10.10.10.3 port=5433 dbname=examify pool_size=30 reserve_pool_size=5 max_db_connections=50 pool_mode=transaction

[pgbouncer]
listen_addr = 0.0.0.0
listen_port = 5432
auth_type = scram-sha-256
auth_file = /etc/pgbouncer/userlist.txt
auth_user = postgres
auth_dbname = examify
auth_query = SELECT rolname, CASE WHEN rolvaliduntil < now() THEN NULL ELSE rolpassword END FROM pg_authid WHERE rolname=$1 AND rolcanlogin
admin_users = pgbouncer_admin
stats_users = pgbouncer_stats
pool_mode = transaction
max_client_conn = 600
default_pool_size = 30
reserve_pool_size = 5
max_db_connections = 50
max_prepared_statements = 0
query_wait_timeout = 5
transaction_timeout = 15
idle_transaction_timeout = 60
server_login_retry = 3
server_reset_query = DISCARD ALL
ignore_startup_parameters = extra_float_digits,options,statement_timeout,search_path
log_connections = 0
log_disconnections = 0
